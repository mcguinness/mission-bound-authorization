{
  "format": "mission-authzen-cases/1",
  "group": "operation-target",
  "description": "D457: the PEP-established resource.properties.operation_target, the PDP entry match against it, and its place in permit reuse and execution",
  "spec": "draft-mcguinness-mission-authzen",
  "cases": [
    {
      "id": "az-ot-01",
      "description": "Same audience; the target is the exact entry's invoice",
      "role": "pdp",
      "requires": [
        "pdp.operation-target"
      ],
      "check": "evaluate",
      "input": {
        "request": {
          "resource": {
            "type": "invoice",
            "id": "inv_2026Q3_842",
            "properties": {
              "audience": "https://erp.example.com",
              "operation_target": "https://erp.example.com/invoices/inv_2026Q3_842"
            }
          },
          "action": {
            "name": "invoices.read"
          }
        },
        "credential_authority": [
          {
            "type": "mission_resource_access",
            "resource": "https://erp.example.com/invoices/inv_2026Q3_842",
            "actions": [
              "invoices.read"
            ]
          }
        ],
        "current_effective_authority": [
          {
            "type": "mission_resource_access",
            "resource": "https://erp.example.com/invoices/inv_2026Q3_842",
            "actions": [
              "invoices.read"
            ]
          }
        ],
        "pep_enforcement_scope": [
          {
            "resource": "https://erp.example.com",
            "resource_match": "prefix"
          }
        ]
      },
      "expected": {
        "outcome": "permit",
        "reason": "both bounds' exact entries equal the operation target"
      },
      "refs": [
        "#1276 sketch step 6",
        "D457"
      ]
    },
    {
