    {
      "id": "ev-amt-05",
      "description": "A max_amount amount that is a non-numeric token",
      "role": "authorization-server",
      "requires": [
        "constraint.max_amount"
      ],
      "check": "entry-validation",
      "input": {
        "entry": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ],
          "constraints": {
            "max_amount": {
              "amount": "NaN",
              "currency": "USD"
            }
          }
        }
      },
      "expected": {
        "outcome": "refuse",
        "reason": "a decimal value outside the grammar is malformed and refused at submission, never parsed",
        "error": "invalid_authorization_details"
      },
      "refs": [
        "#819",
        "D684"
      ]
