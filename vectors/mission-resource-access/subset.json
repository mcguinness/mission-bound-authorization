{
  "format": "mission-resource-access-cases/1",
  "group": "subset",
  "description": "Item 1's four resource cases (D447), and items 5 and 6",
  "spec": "draft-mcguinness-oauth-mission-resource-access",
  "cases": [
    {
      "id": "sub-res-01",
      "description": "exact A under exact B, equal resources",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders/123",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders/123",
          "actions": [
            "invoices.read",
            "invoices.write"
          ]
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "literal equality"
      },
      "refs": [
        "#1258 item 1",
        "D447 subset case 1"
      ]
    },
    {
      "id": "sub-res-02",
      "description": "exact A under exact B, host case differs",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://API.EXAMPLE/orders/123",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders/123",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "exact comparison is literal"
      },
      "refs": [
        "#1258 item 1",
        "D447 subset case 1"
      ]
    },
    {
      "id": "sub-res-03",
      "description": "exact A under exact B, A carries a query B lacks",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders?id=1",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "the query is part of the exact identity"
      },
      "refs": [
        "#1258 item 1",
        "D447 disposition 3"
      ]
    },
    {
      "id": "sub-res-04",
      "description": "exact A under prefix B",
      "role": "authorization-server",
      "requires": [
        "resource-match.prefix"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders/123",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders",
          "resource_match": "prefix",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "B's prefix matcher admits A"
      },
      "refs": [
        "#1258 item 1",
        "D447 subset case 2"
      ]
    },
    {
      "id": "sub-res-05",
      "description": "exact A under prefix B, A outside the boundary",
      "role": "authorization-server",
      "requires": [
        "resource-match.prefix"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://api.example/ordersx",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders",
          "resource_match": "prefix",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "not at a path-segment boundary"
      },
      "refs": [
        "#1258 item 1",
        "D447 subset case 2"
      ]
    },
    {
      "id": "sub-res-06",
      "description": "prefix A within prefix B",
      "role": "authorization-server",
      "requires": [
        "resource-match.prefix"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders/2026/",
          "resource_match": "prefix",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders",
          "resource_match": "prefix",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "B admits A's normalized base, so every target A admits"
      },
      "refs": [
        "#1258 item 1",
        "D447 subset case 3"
      ]
    },
    {
      "id": "sub-res-07",
      "description": "prefix A /orders under prefix B /orders/",
      "role": "authorization-server",
      "requires": [
        "resource-match.prefix"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders",
          "resource_match": "prefix",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders/",
          "resource_match": "prefix",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "B does not admit the bare /orders that A admits"
      },
      "refs": [
        "#1258 item 1",
        "D447 subset case 3"
      ]
    },
    {
      "id": "sub-res-08",
      "description": "prefix A under exact B",
      "role": "authorization-server",
      "requires": [
        "resource-match.prefix"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders",
          "resource_match": "prefix",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://api.example/orders",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "a prefix candidate is never within an exact reference"
      },
      "refs": [
        "#1258 item 1",
        "D447 subset case 4"
      ]
    },
    {
      "id": "sub-ra-01",
      "description": "B requires_action_approval false, A omits the member",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "constraint.requires_action_approval"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ],
          "constraints": {
            "requires_action_approval": false
          }
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "false is equivalent to omitting the member, for comparison only"
      },
      "refs": [
        "#1258 item 5"
      ]
    },
    {
      "id": "sub-ra-02",
      "description": "B requires_action_approval true, A omits the member",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "constraint.requires_action_approval"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ],
          "constraints": {
            "requires_action_approval": true
          }
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "A would drop the approval requirement"
      },
      "refs": [
        "#1258 item 5"
      ]
    },
    {
      "id": "sub-act-01",
      "description": "A's literal action within B's action family",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "action-families"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.*"
          ]
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "a literal action extending the family at a segment boundary"
      },
      "refs": [
        "#1258 item 11"
      ]
    },
    {
      "id": "sub-eq-01",
      "description": "A equals B, carrying all nine initial Common Constraints",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "constraint.max_amount",
        "constraint.resource_issued_after",
        "constraint.resource_issued_before",
        "constraint.tenant",
        "constraint.recipient_domain",
        "constraint.time_window",
        "constraint.data_classification",
        "constraint.allowed_tools",
        "constraint.requires_action_approval"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ],
          "constraints": {
            "max_amount": {
              "amount": "500.00",
              "currency": "USD"
            },
            "resource_issued_after": "2026-01-01T00:00:00Z",
            "resource_issued_before": "2026-12-31T00:00:00Z",
            "tenant": "acme",
            "recipient_domain": "example.com",
            "time_window": {
              "not_before": "2026-01-01T00:00:00Z",
              "not_after": "2026-12-31T00:00:00Z"
            },
            "data_classification": [
              "internal"
            ],
            "allowed_tools": [
              "get_invoice"
            ],
            "requires_action_approval": true
          }
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ],
          "constraints": {
            "max_amount": {
              "amount": "500.00",
              "currency": "USD"
            },
            "resource_issued_after": "2026-01-01T00:00:00Z",
            "resource_issued_before": "2026-12-31T00:00:00Z",
            "tenant": "acme",
            "recipient_domain": "example.com",
            "time_window": {
              "not_before": "2026-01-01T00:00:00Z",
              "not_after": "2026-12-31T00:00:00Z"
            },
            "data_classification": [
              "internal"
            ],
            "allowed_tools": [
              "get_invoice"
            ],
            "requires_action_approval": true
          }
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "every value is within an equal value"
      },
      "refs": [
        "#819",
        "D684"
      ]
    },
    {
      "id": "sub-act-02",
      "description": "A names an action B lacks",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read",
            "invoices.write"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ]
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "every candidate action must be within some reference action"
      },
      "refs": [
        "#819",
        "D684"
      ]
    },
    {
      "id": "sub-act-03",
      "description": "A names a proper subset of B's actions",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read",
            "invoices.write"
          ]
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "each candidate action is within an equal reference action"
      },
      "refs": [
        "#819",
        "D684"
      ]
    },
    {
      "id": "sub-rc-01",
      "description": "A and B carry the same contract reference",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "member.resource_contract"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ],
          "resource_contract": {
            "id": "https://payments.example/contracts/payments",
            "version": "2026-10-20",
            "digest": "sha-256:JOUSo-Axu_CQ7BktLeK9cp4dVJOtCKLLcAG4IKPW2bQ"
          }
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ],
          "resource_contract": {
            "id": "https://payments.example/contracts/payments",
            "version": "2026-10-20",
            "digest": "sha-256:JOUSo-Axu_CQ7BktLeK9cp4dVJOtCKLLcAG4IKPW2bQ"
          }
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "the reference is preserved exactly, member for member"
      },
      "refs": [
        "#819",
        "D684"
      ]
    },
    {
      "id": "sub-rc-02",
      "description": "B carries a contract reference and A omits it",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "member.resource_contract"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ]
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ],
          "resource_contract": {
            "id": "https://payments.example/contracts/payments",
            "version": "2026-10-20",
            "digest": "sha-256:JOUSo-Axu_CQ7BktLeK9cp4dVJOtCKLLcAG4IKPW2bQ"
          }
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "removing a reference is never narrowing"
      },
      "refs": [
        "#819",
        "D684"
      ]
    },
    {
      "id": "sub-rc-03",
      "description": "A carries a contract reference that B, an approved entry, lacks",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "member.resource_contract"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ],
          "resource_contract": {
            "id": "https://payments.example/contracts/payments",
            "version": "2026-10-20",
            "digest": "sha-256:JOUSo-Axu_CQ7BktLeK9cp4dVJOtCKLLcAG4IKPW2bQ"
          }
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ]
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "adding a reference is never narrowing; the approval exception applies only against a policy ceiling"
