            "digest": "sha-256:JOUSo-Axu_CQ7BktLeK9cp4dVJOtCKLLcAG4IKPW2bQ"
          }
        }
      },
      "expected": {
        "outcome": "not-subset",
        "reason": "replacing a reference is never narrowing"
      },
      "refs": [
        "#819",
        "D684"
      ]
    }
  ]
