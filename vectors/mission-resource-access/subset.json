      "refs": [
        "#819",
        "D684"
      ]
    },
    {
      "id": "sub-rc-04",
      "description": "A's contract reference differs from B's in digest",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "member.resource_contract"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ],
          "resource_contract": {
            "id": "https://payments.example/contracts/payments",
            "version": "2026-10-20",
            "digest": "sha-256:JOUSo-Axu_CQ7BktLeK9cp4dVJOtCKLLcAG4IKPW2bA"
          }
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://payments.example/mcp",
          "actions": [
            "payments:invoice.read"
          ],
          "resource_contract": {
            "id": "https://payments.example/contracts/payments",
            "version": "2026-10-20",
            "digest": "sha-256:JOUSo-Axu_CQ7BktLeK9cp4dVJOtCKLLcAG4IKPW2bQ"
          }
        }
      },
      "expected": {
        "outcome": "not-subset",
