{
  "format": "mission-resource-access-cases/1",
  "group": "constraints",
  "description": "Item 3: the nine Common Constraints, positive, negative and boundary, and extension refusal",
  "spec": "draft-mcguinness-oauth-mission-resource-access",
  "cases": [
    {
      "id": "cc-max_amount-positive",
      "description": "max_amount: positive",
      "role": "authorization-server",
      "requires": [
        "subset.exact-resource",
        "constraint.max_amount"
      ],
      "check": "subset",
      "input": {
        "candidate": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ],
          "constraints": {
            "max_amount": {
              "amount": "100.00",
              "currency": "USD"
            }
          }
        },
        "reference": {
          "type": "mission_resource_access",
          "resource": "https://erp.example.com",
          "actions": [
            "invoices.read"
          ],
          "constraints": {
            "max_amount": {
              "amount": "500.00",
              "currency": "USD"
            }
          }
        }
      },
      "expected": {
        "outcome": "subset",
        "reason": "smaller amount, same currency"
      },
      "refs": [
        "#1258 item 3"
      ]
    },
    {
      "id": "cc-max_amount-negative",
