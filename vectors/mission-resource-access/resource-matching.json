{
  "format": "mission-resource-access-cases/1",
  "group": "resource-matching",
  "description": "Item 1 (D447) and item 10: operation targets, exact and prefix matching",
  "spec": "draft-mcguinness-oauth-mission-resource-access",
  "cases": [
    {
      "id": "rm-rpc-01",
      "description": "RPC orders.read for order 123; entry https://api.example/orders/123 (exact)",
      "role": "resource-server",
      "requires": [
        "resource-match.exact",
        "operation-target"
      ],
      "check": "resource-match",
      "input": {
        "operation": {
          "metadata_identifier": "https://api.example",
          "transport_endpoint": "https://api.example/rpc",
          "validated_operation": "orders.read",
          "arguments": {
            "order": "123"
          }
        },
        "target": "https://api.example/orders/123",
        "entry": {
          "resource": "https://api.example/orders/123",
          "resource_match": "exact"
        }
      },
      "expected": {
        "outcome": "match",
        "reason": "the entry equals the operation target"
      },
      "refs": [
        "#1258 item 1",
        "D447 RPC example"
      ]
    },
    {
