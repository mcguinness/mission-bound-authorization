{
  "format": "mission-resource-access-cases/1",
  "group": "delegation",
  "description": "Items 8 and 11: inherited eligibility and delegate matchers",
  "spec": "draft-mcguinness-oauth-mission-resource-access",
  "cases": [
    {
      "id": "dg-match-01",
      "description": "A matcher with sub and sub_profile; the delegate satisfies both",
      "role": "authorization-server",
      "requires": [
        "delegate-matcher"
      ],
      "check": "delegate-matcher",
      "input": {
        "delegate": {
          "sub": "agent-b",
          "sub_profile": "ai_agent"
        },
        "allowed_delegates": [
          {
            "sub": "agent-b",
            "sub_profile": "ai_agent"
          }
        ]
      },
      "expected": {
        "outcome": "permitted",
        "reason": "conjunction within a matcher"
      },
      "refs": [
        "#1258 item 11"
      ]
    },
    {
      "id": "dg-match-02",
      "description": "A matcher with sub and sub_profile; the delegate lacks the profile",
      "role": "authorization-server",
      "requires": [
        "delegate-matcher"
      ],
      "check": "delegate-matcher",
      "input": {
        "delegate": {
          "sub": "agent-b"
        },
        "allowed_delegates": [
          {
            "sub": "agent-b",
            "sub_profile": "ai_agent"
          }
        ]
      },
      "expected": {
        "outcome": "not-permitted",
        "reason": "conjunction within a matcher"
      },
      "refs": [
        "#1258 item 11"
      ]
    },
    {
      "id": "dg-match-03",
      "description": "A matcher with sub and sub_profile; another client with the profile",
      "role": "authorization-server",
      "requires": [
        "delegate-matcher"
      ],
      "check": "delegate-matcher",
      "input": {
        "delegate": {
          "sub": "agent-c",
          "sub_profile": "ai_agent"
        },
        "allowed_delegates": [
          {
            "sub": "agent-b",
            "sub_profile": "ai_agent"
          }
        ]
      },
      "expected": {
        "outcome": "not-permitted",
        "reason": "conjunction within a matcher"
      },
      "refs": [
        "#1258 item 11"
      ]
    },
    {
      "id": "dg-match-04",
      "description": "Two matchers; the delegate satisfies the second",
      "role": "authorization-server",
      "requires": [
        "delegate-matcher"
      ],
      "check": "delegate-matcher",
      "input": {
        "delegate": {
          "sub": "agent-c",
          "sub_profile": "ai_agent"
        },
        "allowed_delegates": [
          {
            "sub": "agent-b"
          },
          {
            "sub_profile": "ai_agent"
          }
        ]
      },
      "expected": {
        "outcome": "permitted",
        "reason": "disjunction across matchers"
      },
      "refs": [
        "#1258 item 11"
      ]
    },
    {
      "id": "dg-match-05",
      "description": "A self-asserted profile is not an asserted one",
      "role": "authorization-server",
      "requires": [
        "delegate-matcher"
      ],
      "check": "delegate-matcher",
      "input": {
        "delegate": {
          "sub": "agent-c",
          "self_asserted_profile": "ai_agent"
        },
        "allowed_delegates": [
          {
            "sub_profile": "ai_agent"
          }
        ]
      },
      "expected": {
        "outcome": "not-permitted",
        "reason": "only the authorization server's asserted profile satisfies a matcher"
      },
      "refs": [
        "#1258 item 11"
      ]
    },
    {
      "id": "dg-policy-01",
      "description": "No allowed_delegates; the deployment policy denies",
      "role": "authorization-server",
      "requires": [
        "delegate-matcher"
      ],
      "check": "delegate-matcher",
      "input": {
        "delegate": {
          "sub": "agent-c",
          "sub_profile": "ai_agent"
        },
        "allowed_delegates": null,
        "policy": "deny-all"
      },
      "expected": {
        "outcome": "not-permitted",
        "reason": "absence defers to policy, never a blanket grant"
      },
      "refs": [
        "#1258 item 8"
      ]
    },
    {
      "id": "dg-inherit-01",
      "description": "Policy denies Carol; the derived entry's list names her",
      "role": "authorization-server",
      "requires": [
        "delegation.policy",
        "delegation.inherited-eligibility"
      ],
      "check": "delegate-eligibility",
      "input": {
        "ceiling_entry_delegation": {
          "max_depth": 2
        },
        "approved_entry_delegation": {
          "max_depth": 2
        },
        "policy": {
          "permit": [
            "bob"
          ],
          "deny": [
            "carol"
          ]
        },
        "entry_delegation": {
          "max_depth": 2,
          "allowed_delegates": [
            {
              "sub": "carol"
            }
          ]
        },
        "delegate": {
          "sub": "carol"
        },
        "depth": 2
      },
      "expected": {
        "outcome": "not-eligible",
        "reason": "the list permits Carol and the depth is within bounds; only the inherited policy denies her"
      },
      "refs": [
        "#1258 item 8",
        "#1275",
        "#1277 review finding 4"
      ]
    },
    {
      "id": "dg-inherit-02",
      "description": "Policy permits Bob; the derived entry's list omits him",
      "role": "authorization-server",
      "requires": [
        "delegation.policy",
        "delegation.inherited-eligibility"
      ],
      "check": "delegate-eligibility",
      "input": {
        "ceiling_entry_delegation": {
          "max_depth": 2
        },
        "approved_entry_delegation": {
          "max_depth": 2
        },
        "policy": {
          "permit": [
            "bob"
          ],
          "deny": [
            "carol"
          ]
        },
        "entry_delegation": {
          "max_depth": 2,
          "allowed_delegates": [
            {
              "sub": "carol"
            }
          ]
        },
        "delegate": {
          "sub": "bob"
        },
        "depth": 2
      },
      "expected": {
        "outcome": "not-eligible",
        "reason": "the policy permits Bob and the depth is within bounds; only the list excludes him"
      },
      "refs": [
        "#1258 item 8",
        "#1277 review finding 4"
      ]
    },
    {
      "id": "dg-inherit-03",
      "description": "The approved entry cannot be resolved",
      "role": "authorization-server",
      "requires": [
        "delegation.inherited-eligibility"
      ],
      "check": "delegate-eligibility",
      "input": {
        "ceiling_entry_delegation": {
          "max_depth": 2
        },
        "approved_entry_delegation": null,
        "context": "approved-entry-unresolvable",
        "policy": {
          "permit": [
            "bob"
          ],
          "deny": [
            "carol"
          ]
        },
        "delegate": {
          "sub": "bob"
        },
        "depth": 1
      },
      "expected": {
        "outcome": "narrowed-out",
        "reason": "an unresolved approved entry narrows the entry out"
      },
      "refs": [
        "#1258 item 8"
      ]
    },
    {
      "id": "dg-inherit-04",
      "description": "The approved entry carries a list a proposal added over a ceiling entry without one",
      "role": "authorization-server",
      "requires": [
        "delegation.policy",
        "delegation.inherited-eligibility"
      ],
      "check": "delegate-eligibility",
      "input": {
        "ceiling_entry_delegation": {
          "max_depth": 2
        },
        "approved_entry_delegation": {
          "max_depth": 2,
          "allowed_delegates": [
            {
              "sub": "carol"
            }
          ]
        },
        "policy": {
          "permit": [
            "bob"
          ],
          "deny": [
            "carol"
          ]
        },
        "delegate": {
          "sub": "carol"
        },
        "depth": 1
      },
      "expected": {
        "outcome": "not-eligible",
        "reason": "the retained provenance keeps the policy obligation the approved list no longer shows"
      },
      "refs": [
        "#1258 item 8",
        "#1277 review finding 2"
      ]
    },
    {
      "id": "dg-inherit-05",
      "description": "Policy permits Bob and the derived entry's list names him",
      "role": "authorization-server",
      "requires": [
        "delegation.policy",
        "delegation.inherited-eligibility"
      ],
      "check": "delegate-eligibility",
      "input": {
        "ceiling_entry_delegation": {
          "max_depth": 2
        },
        "approved_entry_delegation": {
          "max_depth": 2
        },
        "policy": {
          "permit": [
            "bob"
          ],
          "deny": [
            "carol"
          ]
        },
        "entry_delegation": {
          "max_depth": 2,
          "allowed_delegates": [
            {
              "sub": "bob"
            }
          ]
        },
        "delegate": {
          "sub": "bob"
        },
        "depth": 2
      },
      "expected": {
        "outcome": "eligible",
        "reason": "both the inherited policy and the list permit Bob within the depth bound"
      },
      "refs": [
        "#1258 item 8",
        "#1277 review finding 4"
      ]
    },
    {
      "id": "dg-inherit-06",
      "description": "The approved entry's provenance cannot be resolved",
      "role": "authorization-server",
      "requires": [
        "delegation.inherited-eligibility"
      ],
      "check": "delegate-eligibility",
      "input": {
        "ceiling_entry_delegation": null,
        "context": "provenance-unresolvable",
        "approved_entry_delegation": {
          "max_depth": 2,
          "allowed_delegates": [
            {
              "sub": "carol"
            }
          ]
        },
        "policy": {
          "permit": [
            "carol"
          ]
        },
        "delegate": {
          "sub": "carol"
        },
        "depth": 1
      },
      "expected": {
        "outcome": "narrowed-out",
        "reason": "unresolved provenance fails closed even where the list and policy would permit"
      },
      "refs": [
        "#1258 item 8",
        "#1277 review finding 2"
      ]
    },
    {
      "id": "dg-inherit-07",
      "description": "The approved list over a ceiling entry without one names Carol, and policy permits her",
      "role": "authorization-server",
      "requires": [
        "delegation.policy",
        "delegation.inherited-eligibility"
      ],
      "check": "delegate-eligibility",
      "input": {
        "ceiling_entry_delegation": {
          "max_depth": 2
        },
        "approved_entry_delegation": {
          "max_depth": 2,
          "allowed_delegates": [
            {
              "sub": "carol"
            }
          ]
        },
        "policy": {
          "permit": [
            "carol"
          ]
        },
        "delegate": {
          "sub": "carol"
        },
        "depth": 1
      },
      "expected": {
        "outcome": "eligible",
        "reason": "retained provenance adds the policy check; it does not deny what both permit"
      },
      "refs": [
        "#1258 item 8",
        "#1277 review finding 2"
      ]
    }
  ]
}
