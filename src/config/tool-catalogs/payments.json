{
  "tools": [
    {
      "name": "list_invoices",
      "description": "List invoices",
      "inputSchema": {
        "type": "object",
        "properties": { "vendor_id": { "type": "string" } },
        "additionalProperties": false
      }
    },
    {
      "name": "get_invoice",
      "description": "Read one invoice",
      "inputSchema": {
        "type": "object",
        "properties": { "invoice_id": { "type": "string" } },
        "required": ["invoice_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "lookup_vendor",
      "description": "Look up a vendor",
      "inputSchema": {
        "type": "object",
        "properties": { "vendor_id": { "type": "string" } },
        "required": ["vendor_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "schedule_payment",
      "description": "Schedule a payment",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_id": { "type": "string" },
          "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
        },
        "required": ["invoice_id", "idempotency_key"],
        "additionalProperties": false
      }
    },
    {
      "name": "cancel_scheduled_payment",
      "description": "Cancel a scheduled payment",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_id": { "type": "string" },
          "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
        },
        "required": ["invoice_id", "idempotency_key"],
        "additionalProperties": false
      }
    },
    {
      "name": "check_transfer",
      "description": "Check whether a wire transfer is feasible, reserving nothing",
      "inputSchema": {
        "type": "object",
        "properties": { "invoice_id": { "type": "string" } },
        "required": ["invoice_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "hold_transfer",
      "description": "Place a hold for a wire transfer",
      "inputSchema": {
        "type": "object",
        "properties": { "invoice_id": { "type": "string" } },
        "required": ["invoice_id"],
        "additionalProperties": false
      }
    },
    {
      "name": "execute_wire_transfer",
      "description": "Execute a wire transfer",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_id": { "type": "string" },
          "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
        },
        "required": ["invoice_id", "idempotency_key"],
        "additionalProperties": false
      }
    },
    {
      "name": "send_remittance_email",
      "description": "Send remittance advice",
      "inputSchema": {
        "type": "object",
        "properties": {
          "invoice_id": { "type": "string" },
          "idempotency_key": { "type": "string", "pattern": "^[A-Za-z0-9_-]{16,128}$" }
        },
        "required": ["invoice_id", "idempotency_key"],
        "additionalProperties": false
      }
    }
  ]
}
