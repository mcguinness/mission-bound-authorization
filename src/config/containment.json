{
  "policy_version": "demo-containment-1",
  "rules": [
    {
      "rule_id": "contain-external-comms-on-taint-v1",
      "event_type": "content.tainted_read",
      "remove": [
        {
          "resource": "http://localhost:4403/mcp",
          "actions": ["payments:remittance.send"]
        }
      ]
    }
  ],
  "sources": [
    {
      "source": "svc:soc",
      "event_types": ["content.tainted_read"],
      "key": { "kid": "soc-source-es256", "alg": "ES256" }
    },
    {
      "source": "svc:harness-egress",
      "event_types": ["egress.destination_unlisted", "egress.undeclared"],
      "key": { "kid": "harness-egress-es256", "alg": "ES256" },
      "advisory": true
    }
  ]
}
