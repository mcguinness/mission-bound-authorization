{
  "mediated_scope": {
    "resources": ["http://localhost:4403/mcp"],
    "action_classes": ["consequential_read", "consequential_write", "irreversible_action", "external_commitment"],
    "execution_paths": ["mcp:tools/call"],
    "pep_locations": ["mcp-payments-pep"],
    "excluded_paths": [],
    "mission_establishment_mode": "token-claim"
  },
  "authority_entry_types": [{"type": "mission_resource_access", "evaluator": "fga-contextual-check"}],
  "pdps": ["mcp-payments-pdp"],
  "state_source": {
    "source": "kernel-committed load_view",
    "placement": "pep",
    "max_staleness_seconds": 300,
    "mission_max_stale_seconds": 300,
    "pdp_unavailability_posture": "deny",
    "unknown_action_class": "deny",
    "per_class": {
      "non_consequential": {"freshness_posture": "bounded", "max_staleness_seconds": 300, "recovery_objective_seconds": 60, "beyond_bound": "deny"},
      "consequential_read": {"freshness_posture": "bounded", "max_staleness_seconds": 300, "recovery_objective_seconds": 60, "beyond_bound": "deny"},
      "consequential_write": {"freshness_posture": "bounded", "max_staleness_seconds": 300, "recovery_objective_seconds": 60, "beyond_bound": "deny"},
      "irreversible_action": {"freshness_posture": "bounded", "max_staleness_seconds": 30, "recovery_objective_seconds": 60, "beyond_bound": "deny"},
      "external_commitment": {"freshness_posture": "bounded", "max_staleness_seconds": 60, "recovery_objective_seconds": 60, "beyond_bound": "deny"},
      "privileged_administration": {"freshness_posture": "bounded", "max_staleness_seconds": 30, "recovery_objective_seconds": 60, "beyond_bound": "deny"},
      "audit_only": {"freshness_posture": "none"}
    },
    "availability_consequence": "An unavailable PDP denies immediately. Stale state denies even if recovery takes longer than the class bound; an outage never restarts observation age or extends a permit.",
    "replication": "none",
    "break_glass": "absent"
  },
  "remote_decision_channels": [],
  "record_integrity_mechanism": "emitter-signed append-only runtime evidence; full Evidence capability not claimed",
  "enforcement_boundaries": {
    "versions": [
      {
        "version": "payments-boundary-v1",
        "effective_at": "1970-01-01T00:00:00Z",
        "boundaries": [
          {
            "boundary": "http://localhost:4403/mcp",
            "pep_locations": ["mcp-payments-pep"],
            "audience_aliases": [],
            "evidence_keys": [
              {"kid": "pdp-decision-evidence", "emitter": "http://localhost:4403/mcp", "role": "pdp"},
              {"kid": "ephemeral-pep", "emitter": "http://localhost:4403/mcp", "role": "pep"},
              {"kid": "ephemeral-executor", "emitter": "http://localhost:4403/mcp", "role": "executor"}
            ]
          }
        ]
      }
    ]
  },
  "extensions": {
    "transaction_assurance": [
      {
        "mediated_class_or_scope": "irreversible_action",
        "idempotency_claim_domain": "pdp-local: mcp-payments-pdp, durable single-writer SQLite (Exact: one serializing PDP)",
        "idempotency_claim_owner": "mcp-payments-pdp",
        "idempotency_enforcement_profile": "exact",
        "idempotency_claim_topology": "local-single-writer",
        "idempotency_scope": ["mission", "subject", "actor", "audience", "action", "resource", "phase"],
        "idempotency_horizon_seconds": 604800,
        "execution_lease_max_seconds": 30,
        "execution_lease_consumer": "mcp-payments-pep"
      },
      {
        "mediated_class_or_scope": "external_commitment",
        "idempotency_claim_domain": "pdp-local: mcp-payments-pdp, durable single-writer SQLite (Exact: one serializing PDP)",
        "idempotency_claim_owner": "mcp-payments-pdp",
        "idempotency_enforcement_profile": "exact",
        "idempotency_claim_topology": "local-single-writer",
        "idempotency_scope": ["mission", "subject", "actor", "audience", "action", "resource", "phase"],
        "idempotency_horizon_seconds": 604800,
        "execution_lease_max_seconds": 30,
        "execution_lease_consumer": "mcp-payments-pep"
      }
    ],
    "reversible_write_idempotency": [
      {
        "mediated_class_or_scope": "payments:payment.schedule",
        "permit_lifetime_control": "validity_window_plus_idempotency_key",
        "permit_validity_max_seconds": 300,
        "reservation_domain": "pep-local: mcp-payments-pep, durable single-writer SQLite",
        "reservation_owner": "mcp-payments-pep",
        "idempotency_scope": ["mission", "subject", "actor", "audience", "action", "resource", "phase"],
        "retention_posture": "declared_horizon",
        "retention_horizon": "P7D"
      },
      {
        "mediated_class_or_scope": "payments:payment.schedule.cancel",
        "permit_lifetime_control": "validity_window_plus_idempotency_key",
        "permit_validity_max_seconds": 300,
        "reservation_domain": "pep-local: mcp-payments-pep, durable single-writer SQLite",
        "reservation_owner": "mcp-payments-pep",
        "idempotency_scope": ["mission", "subject", "actor", "audience", "action", "resource", "phase"],
        "retention_posture": "declared_horizon",
        "retention_horizon": "P7D"
      },
      {
        "mediated_class_or_scope": "consequential_write",
        "permit_lifetime_control": "single_use_decision_identifier",
        "consumed_identifier_domain": "pep-local: mcp-payments-pep, durable single-writer SQLite",
        "consumed_identifier_owner": "mcp-payments-pep",
        "retention_posture": "permit_acceptance_window"
      }
    ],
    "execution_capabilities": [
      {
        "operation": "payments:payment.schedule",
        "action_class": "consequential_write",
        "durable_idempotency": {"held_by": "pep_reservation", "new_operation": "a new action.properties.idempotency_key; a second active schedule for the invoice is refused schedule_exists"},
        "conditional_effect": "none",
        "outcome_lookup": {"identifier": "idempotency claim (idempotency scope, idempotency_key)", "method": "the PEP's write reservation, committed with the schedule in one local transaction"},
        "commit_point": "the local transaction that records the schedule and completes its reservation",
        "cancellation": "none before the commit point; after it, cancel_scheduled_payment withdraws the schedule as its own operation under its own Decision",
        "compensation": "none",
        "unknown_outcome_recovery": "outcome_lookup",
        "asserted": []
      },
      {
        "operation": "payments:payment.schedule.cancel",
        "action_class": "consequential_write",
        "durable_idempotency": {"held_by": "pep_reservation", "new_operation": "a new action.properties.idempotency_key; with no active schedule left it is refused schedule_not_found"},
        "conditional_effect": "none",
        "outcome_lookup": {"identifier": "idempotency claim (idempotency scope, idempotency_key)", "method": "the PEP's write reservation, committed with the cancellation in one local transaction"},
        "commit_point": "the local transaction that cancels the schedule and completes its reservation",
        "cancellation": "none",
        "compensation": "none",
        "unknown_outcome_recovery": "outcome_lookup",
        "asserted": []
      },
      {
        "operation": "payments:payment.execute",
        "phase": "prepare",
        "action_class": "consequential_write",
        "durable_idempotency": "none",
        "conditional_effect": "none",
        "outcome_lookup": "none",
        "commit_point": "the PEP's response; the simulated hold records no state",
        "cancellation": "none",
        "compensation": "none",
        "unknown_outcome_recovery": "hold",
        "asserted": []
      },
      {
        "operation": "payments:payment.execute",
        "phase": "commit",
        "action_class": "irreversible_action",
        "durable_idempotency": {"held_by": "pdp_claim", "new_operation": "a new action.properties.idempotency_key at the PDP claim; the PEP's operation key omits it, so a new identical wire is refused operation_already_claimed, and a settled invoice already_settled"},
        "conditional_effect": "none",
        "outcome_lookup": {"identifier": "evaluation_id", "method": "the ledger connector's committed entry for the permit identifier, held in memory for the process lifetime"},
        "commit_point": "ledger connector acceptance",
        "cancellation": "before the commit point, an expired execution lease or a failed reverification suppresses the effect; nothing stops it after",
        "compensation": "none",
        "unknown_outcome_recovery": "outcome_lookup",
        "asserted": []
      },
      {
        "operation": "payments:remittance.send",
        "action_class": "external_commitment",
        "durable_idempotency": {"held_by": "pdp_claim", "new_operation": "a new action.properties.idempotency_key at the PDP claim; the PEP's operation key omits it, so a new identical notice is refused operation_already_claimed"},
        "conditional_effect": "none",
        "outcome_lookup": {"identifier": "evaluation_id", "method": "the outbox connector's accepted entry for the permit identifier, held in memory for the process lifetime"},
        "commit_point": "outbox connector acceptance",
        "cancellation": "before the commit point, an expired execution lease or a failed reverification suppresses the effect; nothing stops it after",
        "compensation": "none",
        "unknown_outcome_recovery": "outcome_lookup",
        "asserted": []
      }
    ],
    "outcome_reconciliation": {
      "window": "PT15M",
      "responsible_component": "mcp-payments-pep",
      "alerting": "an operator alert for every idempotency claim that closes indeterminate",
      "prior_process_outcomes": "indeterminate_at_window_close"
    }
  }
}
