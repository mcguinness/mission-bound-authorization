{
  "policy_version": "demo-policy-1",
  "ceiling": [
    {
      "type": "mission_resource_access",
      "resource": "http://localhost:4403/mcp",
      "actions": ["payments:invoice.list", "payments:invoice.read", "payments:vendor.read"],
      "constraints": {
        "vendors": ["acme"]
      },
      "delegation": {
        "max_depth": 2,
        "allowed_delegates": [{ "sub_profile": "ai_agent" }],
        "children": {
          "max_children": 5,
          "max_child_depth": 2,
          "allowed_child_actors": [{ "sub_profile": "ai_agent" }]
        }
      }
    },
    {
      "type": "mission_resource_access",
      "resource": "http://localhost:4403/mcp",
      "actions": ["payments:payment.schedule", "payments:payment.execute", "payments:remittance.send"],
      "constraints": {
        "max_amount": { "amount": "500.00", "currency": "USD" },
        "vendors": ["acme"]
      },
      "delegation": {
        "max_depth": 2,
        "allowed_delegates": [{ "sub_profile": "ai_agent" }],
        "children": {
          "max_children": 5,
          "max_child_depth": 2,
          "allowed_child_actors": [{ "sub_profile": "ai_agent" }]
        }
      }
    },
    {
      "type": "mission_resource_access",
      "resource": "http://localhost:4406/mcp",
      "actions": ["ledger:vendor.read", "ledger:journal.write"],
      "constraints": {
        "vendors": ["acme"]
      }
    }
  ],
  "write_actions": [
    "payments:payment.schedule",
    "payments:payment.execute",
    "payments:remittance.send"
  ],
  "dispatch_prohibited_actions": [
    "payments:payment.execute",
    "payments:remittance.send"
  ],
  "max_mission_lifetime_s": null
}
